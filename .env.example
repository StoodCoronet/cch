# Required: Master secret for auth token generation. Generate with: openssl rand -hex 32
HANDY_MASTER_SECRET=

# Required for admin UI at /admin. Choose a strong password.
ADMIN_PASSWORD=

# Required for public deployment: your domain, e.g. cch.example.com
# DNS A record must point to the ECS public IP; Caddy gets the cert automatically.
DOMAIN=

# Required for public deployment: full public base URL, e.g. https://cch.example.com
PUBLIC_URL=

# Optional: comma-separated CORS whitelist for browser cross-origin access.
# Default (unset) = same-origin only, which is correct when the dashboard is
# served by this server. Set to your domain if unsure: https://cch.example.com
# ALLOWED_ORIGINS=

# Optional: server port (default 3005)
# PORT=3005
