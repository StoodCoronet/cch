# Required: Master secret for auth token generation. Generate with: openssl rand -hex 32
HANDY_MASTER_SECRET=

# Required for admin UI at /admin. Choose a strong password.
ADMIN_PASSWORD=

# Required for public deployment: your domain, e.g. cch.example.com
# DNS A record must point to the ECS public IP; Caddy gets the cert automatically.
DOMAIN=

# Required for public deployment: full public base URL, e.g. https://cch.example.com
PUBLIC_URL=

# Optional: comma-separated CORS whitelist for browser cross-origin access.
# Default (unset) = same-origin only, which is correct when the dashboard is
# served by this server. Set to your domain if unsure: https://cch.example.com
# ALLOWED_ORIGINS=

# Optional: plaintext message retention (messages are a rolling cache, not an
# archive). MESSAGE_CAP_PER_SESSION = newest N messages kept per session
# (default 500); MESSAGE_TTL_DAYS = hourly sweep deletes messages older than
# this many days (default 30).
# MESSAGE_CAP_PER_SESSION=500
# MESSAGE_TTL_DAYS=30

# Optional: SMTP for email verification codes (registration + password reset).
# All five must be set to enable sending.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Development only: when SMTP is not configured and this is true, verification
# codes are logged and returned in API responses as `devCode`. Never enable in
# production.
# ALLOW_DEV_CODES=false

# Optional: Google OAuth login for the web dashboard. Callback URL is
# ${PUBLIC_URL}/v1/auth/google/callback — register it in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: server port (default 3005)
# PORT=3005

# Allowlist for Google sign-in (comma-separated emails). Empty = anyone (not recommended)
# GOOGLE_ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
